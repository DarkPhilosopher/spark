{
  "name": "placeholders",
  "world": {
    "width": 18,
    "height": 12,
    "wrap": false,
    "speed": 6
  },
  "tiles": [
    {
      "name": "count a step",
      "when": [{"tile": "timer", "args": {"every": 1}}],
      "do": [{"tile": "place_value",
              "args": {"who": "steps", "a": "steps", "op": "plus", "b": "1"}}]
    },
    {
      "name": "go home",
      "when": [{"tile": "place_has",
                "args": {"who": "steps", "face": "value",
                         "test": "at least", "amount": "40"}}],
      "do": [{"tile": "place_value",
              "args": {"who": "steps", "a": "0", "op": "plus", "b": "0"}},
             {"tile": "place_jump", "args": {"who": "home"}},
             {"tile": "say", "args": {"text": "back to where I was"}}]
    },
    {
      "name": "eat what I touch",
      "when": [{"tile": "place_named", "args": {"who": "target", "text": "apple"}},
               {"tile": "touch", "args": {"kind": "apple"}}],
      "do": [{"tile": "place_vector",
              "args": {"who": "reach", "axis": "x",
                       "a": "it x", "op": "minus", "b": "my x"}},
             {"tile": "place_value",
              "args": {"who": "eaten", "a": "eaten", "op": "plus", "b": "1"}},
             {"tile": "score", "args": {"amount": 1}},
             {"tile": "vanish", "args": {"target": "it"}},
             {"tile": "spawn", "args": {"kind": "apple"}}]
    }
  ],
  "characters": [
    {
      "kind": "hero",
      "glyph": "@",
      "color": "cyan",
      "health": 3,
      "count": 1,
      "solid": false,
      "role": "player",
      "brain": [
        {
          "when": [{"tile": "always", "args": {}}],
          "do": [{"tile": "place_name", "args": {"who": "target", "text": "apple"}}]
        },
        {
          "when": [{"tile": "combo", "args": {"name": "count a step"}}],
          "do": [{"tile": "combo", "args": {"name": "count a step"}}]
        },
        {
          "when": [{"tile": "timer", "args": {"every": 20}}],
          "do": [{"tile": "place_here", "args": {"who": "home"}}]
        },
        {
          "when": [{"tile": "key", "args": {"key": "up"}}],
          "do": [{"tile": "place_vector",
                  "args": {"who": "step", "axis": "x", "a": "0", "op": "plus", "b": "0"}},
                 {"tile": "place_vector",
                  "args": {"who": "step", "axis": "y", "a": "0", "op": "minus", "b": "1"}},
                 {"tile": "place_move", "args": {"who": "step"}}]
        },
        {
          "when": [{"tile": "key", "args": {"key": "down"}}],
          "do": [{"tile": "place_vector",
                  "args": {"who": "step", "axis": "x", "a": "0", "op": "plus", "b": "0"}},
                 {"tile": "place_vector",
                  "args": {"who": "step", "axis": "y", "a": "0", "op": "plus", "b": "1"}},
                 {"tile": "place_move", "args": {"who": "step"}}]
        },
        {
          "when": [{"tile": "key", "args": {"key": "left"}}],
          "do": [{"tile": "place_vector",
                  "args": {"who": "step", "axis": "x", "a": "0", "op": "minus", "b": "1"}},
                 {"tile": "place_vector",
                  "args": {"who": "step", "axis": "y", "a": "0", "op": "plus", "b": "0"}},
                 {"tile": "place_move", "args": {"who": "step"}}]
        },
        {
          "when": [{"tile": "key", "args": {"key": "right"}}],
          "do": [{"tile": "place_vector",
                  "args": {"who": "step", "axis": "x", "a": "0", "op": "plus", "b": "1"}},
                 {"tile": "place_vector",
                  "args": {"who": "step", "axis": "y", "a": "0", "op": "plus", "b": "0"}},
                 {"tile": "place_move", "args": {"who": "step"}}]
        },
        {
          "when": [{"tile": "combo", "args": {"name": "eat what I touch"}}],
          "do": [{"tile": "place_vector",
                  "args": {"who": "reach", "axis": "y", "a": "it y", "op": "minus", "b": "my y"}},
                 {"tile": "combo", "args": {"name": "eat what I touch"}}]
        },
        {
          "when": [{"tile": "combo", "args": {"name": "go home"}}],
          "do": [{"tile": "combo", "args": {"name": "go home"}}]
        },
        {
          "when": [{"tile": "place_has",
                    "args": {"who": "eaten", "face": "value",
                             "test": "at least", "amount": "root 25"}}],
          "do": [{"tile": "win", "args": {}}]
        },
        {
          "when": [{"tile": "always", "args": {}}],
          "do": [{"tile": "place_value",
                  "args": {"who": "spin", "a": "tick", "op": "remainder", "b": "4"}},
                 {"tile": "place_value",
                  "args": {"who": "grow", "a": "spin", "op": "to the power of", "b": "3"}},
                 {"tile": "place_value",
                  "args": {"who": "grow", "a": "grow", "op": "but no more than", "b": "9"}},
                 {"tile": "place_value",
                  "args": {"who": "grow", "a": "grow", "op": "but no less than", "b": "-9"}},
                 {"tile": "place_value",
                  "args": {"who": "away", "a": "my x", "op": "how far from", "b": "my y"}},
                 {"tile": "place_value",
                  "args": {"who": "creep", "a": "creep", "op": "plus", "b": "0.25"}},
                 {"tile": "place_value",
                  "args": {"who": "root", "a": "root away", "op": "divided by", "b": "3"}},
                 {"tile": "place_value",
                  "args": {"who": "roll", "a": "random 6", "op": "plus", "b": "1"}},
                 {"tile": "place_vector",
                  "args": {"who": "creepstep", "axis": "x",
                           "a": "down creep", "op": "remainder", "b": "2"}}]
        }
      ]
    },
    {
      "kind": "apple",
      "glyph": "o",
      "color": "green",
      "health": 1,
      "count": 4,
      "solid": false,
      "role": "prop",
      "brain": []
    },
    {
      "kind": "drifter",
      "glyph": "x",
      "color": "magenta",
      "health": 2,
      "count": 2,
      "solid": false,
      "role": "prop",
      "brain": [
        {
          "when": [{"tile": "timer", "args": {"every": 3}}],
          "do": [{"tile": "place_vector",
                  "args": {"who": "drift", "axis": "x", "a": "tick", "op": "divided by", "b": "7"}},
                 {"tile": "place_vector",
                  "args": {"who": "drift", "axis": "y", "a": "0", "op": "plus", "b": "0"}},
                 {"tile": "place_move", "args": {"who": "drift"}}]
        },
        {
          "when": [{"tile": "place_has",
                    "args": {"who": "drift", "face": "x", "test": "at least", "amount": 3}}],
          "do": [{"tile": "place_vector",
                  "args": {"who": "drift", "axis": "x", "a": "0", "op": "minus", "b": "1"}}]
        },
        {
          "when": [{"tile": "timer", "args": {"every": 5}}],
          "do": [{"tile": "place_vector",
                  "args": {"who": "drift", "axis": "y",
                           "a": "my age", "op": "remainder", "b": "3"}},
                 {"tile": "place_vector",
                  "args": {"who": "drift", "axis": "y",
                           "a": "drift y", "op": "but no more than", "b": "1"}},
                 {"tile": "place_move", "args": {"who": "drift"}}]
        }
      ]
    }
  ]
}
